<Window x:Class="ThisWidget.WidgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ThisWidget · Widget" Width="460" Height="360" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource Ink}">
  <Viewbox Stretch="Uniform">
    <Border x:Name="Frame" Width="460" Height="360" CornerRadius="18" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
      <Grid Margin="22,18">
        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="88"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="47"/></Grid.RowDefinitions>
        <Grid x:Name="Header" Background="Transparent" MouseLeftButtonDown="DragHeaderDown">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource Accent}" CornerRadius="5" Width="21" Height="21" Margin="0,0,8,0"><TextBlock Text="T" Foreground="{DynamicResource AccentInk}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="ThisWidget" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/><TextBlock x:Name="LockLabel" Text="  · locked" FontSize="9" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Visibility="Collapsed"/></StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="↗" Click="OpenClick" Width="28" Padding="0" ToolTip="Open calendar" AutomationProperties.Name="Open calendar" Margin="0,0,6,0"/><Button Content="⚙" Click="SettingsClick" Width="28" Padding="0" ToolTip="Widget settings" AutomationProperties.Name="Widget settings" Margin="0,0,6,0"/><Button Content="×" Click="RemoveClick" Width="28" Padding="0" ToolTip="Remove widget; calendar stays available in tray" AutomationProperties.Name="Remove widget"/></StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,15,0,0"><Grid><TextBlock x:Name="TodayLabel" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="DateLabel" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><TextBlock x:Name="FocusLabel" Text="Your training, at a glance." FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="53" Margin="0,7,0,0"/></StackPanel>
        <ScrollViewer x:Name="ChecklistScroll" Grid.Row="2" Height="86" Margin="0,0,0,12" Visibility="Collapsed"><StackPanel x:Name="Checklist"/></ScrollViewer>
        <Grid Grid.Row="3" Margin="0,5,0,0"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions><Grid><TextBlock x:Name="YearLabel" Text="YOUR YEAR" Foreground="{DynamicResource Muted}" FontSize="9" FontWeight="SemiBold"/><TextBlock x:Name="WorkoutLabel" Foreground="{DynamicResource Accent}" FontSize="9" HorizontalAlignment="Right"/></Grid><Canvas x:Name="YearGrid" Grid.Row="1" Width="416" Height="88"/><Grid Grid.Row="2" VerticalAlignment="Bottom"><StackPanel Orientation="Horizontal"><Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource Cell}" Margin="0,0,5,0"/><TextBlock Text="Empty" Foreground="{DynamicResource Muted}" FontSize="9" Margin="0,0,14,0"/><Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,5,0"/><TextBlock Text="Complete" Foreground="{DynamicResource Muted}" FontSize="9"/></StackPanel><TextBlock x:Name="StreakLabel" FontSize="9" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/></Grid></Grid>
        <Grid Grid.Row="4" Margin="0,12,0,0"><TextBlock x:Name="GoalLabel" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center"/><Button x:Name="CompleteButton" Content="✓  Mark today done" HorizontalAlignment="Right" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" BorderThickness="0" Padding="12,8" Click="CompleteClick"/></Grid>
      </Grid>
    </Border>
  </Viewbox>
</Window>
