<Window x:Class="ThisWidget.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ThisWidget · Workout Calendar" Width="1000" Height="690" MinWidth="700" MinHeight="483" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource Ink}">

  <Viewbox Stretch="Uniform">
    <Border Width="1000" Height="690" CornerRadius="22" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
      <Grid Margin="28,20,28,18">
        <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
        <Grid x:Name="DragHeader" Background="Transparent" MouseLeftButtonDown="DragHeaderDown">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Accent}" Margin="0,0,10,0"><TextBlock Text="T" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentInk}"/></Border>
            <TextBlock Text="THISWIDGET" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="  /  TRAINING JOURNAL" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Add Widget" Click="WidgetClick" Margin="0,0,8,0" Padding="12,5" ToolTip="Add a fixed widget to your home screen"/><Button x:Name="TodayButton" Content="Today" Click="TodayClick" Margin="0,0,8,0" Padding="12,5"/>
            <Button Content="⚙" ToolTip="Customize appearance, size and backups" AutomationProperties.Name="Customize" Click="SettingsClick" Width="34" Padding="0" Margin="0,0,8,0"/>
            <Button Content="−" ToolTip="Hide to tray. Double-click tray icon to return." AutomationProperties.Name="Hide to tray" Click="HideClick" Width="30" Padding="0" Margin="0,0,4,0"/>
            <Button Content="×" ToolTip="Close calendar; keep widget running" AutomationProperties.Name="Close calendar" Click="CloseClick" Width="30" Padding="0"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,18,0,16">
          <StackPanel><TextBlock Text="Build your year." FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="Subtitle" Text="365 small steps. One stronger you." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
          <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
            <StackPanel Margin="0,0,22,0"><TextBlock x:Name="Sessions" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/><TextBlock Text="WORKOUTS" Foreground="{DynamicResource Muted}" FontSize="9"/></StackPanel>
            <StackPanel Margin="0,0,22,0"><TextBlock x:Name="Streak" Text="0" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="DAY STREAK" Foreground="{DynamicResource Muted}" FontSize="9"/></StackPanel>
            <Button Content="‹" Click="PreviousYear" Padding="9,4" Margin="0,0,6,0" AutomationProperties.Name="Previous year"/><TextBlock x:Name="YearLabel" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Width="64" TextAlignment="Center"/><Button Content="›" Click="NextYear" Padding="9,4" Margin="6,0,0,0" AutomationProperties.Name="Next year"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="265"/></Grid.ColumnDefinitions>
          <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="29"/></Grid.RowDefinitions>
            <UniformGrid x:Name="Months" Rows="3" Columns="4" Margin="-4,-4,-4,0"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="4,0,0,0">
              <Border Background="{DynamicResource Cell}" Width="10" Height="10" CornerRadius="3" Margin="0,0,5,0"/><TextBlock Text="Not logged" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,18,0"/>
              <Border Background="{DynamicResource Accent}" Width="10" Height="10" CornerRadius="3" Margin="0,0,5,0"/><TextBlock Text="Complete" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,18,0"/>
              <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1" Width="10" Height="10" CornerRadius="3" Margin="0,0,5,0"/><TextBlock Text="Today" Foreground="{DynamicResource Muted}" FontSize="10"/>
            </StackPanel>
          </Grid>
          <Border Grid.Column="2" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="18">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel><TextBlock x:Name="DateCaption" Text="TODAY'S TRAINING" Foreground="{DynamicResource Accent}" FontSize="9" FontWeight="SemiBold"/><TextBlock x:Name="DateTitle" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="DateWeekday" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
              <Grid Grid.Row="1" Margin="0,19,0,12"><TextBlock Text="Workout focus" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="Edit day" Click="EditDayClick" HorizontalAlignment="Right" Padding="8,4" FontSize="10"/></Grid>
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Tasks"/></ScrollViewer>
              <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="SESSION NOTES" FontSize="9" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/><TextBox x:Name="Notes" Height="67" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="8000" FontSize="11" TextChanged="NotesChanged" LostFocus="NotesLostFocus" ToolTip="Notes save automatically as you type."/><Button x:Name="CompleteButton" Content="✓  Mark workout complete" Click="CompleteClick" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" BorderThickness="0" Padding="12,12" Margin="0,12,0,0"/></StackPanel>
              <Button Grid.Row="4" Content="↻  Edit weekly split" Click="WeeklyClick" Margin="0,10,0,0" Padding="8,9"/>
            </Grid>
          </Border>
        </Grid>
        <Grid Grid.Row="3" VerticalAlignment="Bottom"><TextBlock Text="Click a day to log training · Right-click to check it off" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="SaveStatus" Text="SAVED ON THIS DEVICE" FontSize="9" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/></Grid>
      </Grid>
    </Border>
  </Viewbox>
</Window>
